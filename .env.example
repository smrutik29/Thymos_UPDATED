# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real credentials.

# --- Local development ---
# These point at the Cloud SQL Auth Proxy running on your machine
# (see project chat/README for exactly how to start the proxy).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=thymos_quiz
DB_USER=quiz_app
DB_PASSWORD=

# --- Waitlist form (native replacement for the old JotForm) ---
# Isolated database on the SAME Cloud SQL instance, reached through the
# same Auth Proxy. WAITLIST_DB_HOST/PORT and WAITLIST_INSTANCE_CONNECTION_NAME
# are optional and fall back to DB_HOST/DB_PORT/INSTANCE_CONNECTION_NAME.
WAITLIST_DB_NAME=thymos_waitlist
WAITLIST_DB_USER=waitlist_app
WAITLIST_DB_PASSWORD=

# --- Provider referral form (isolated DB; holds patient PHI) ---
# Same fallback rules as the WAITLIST_ vars.
REFERRALS_DB_NAME=thymos_referrals
REFERRALS_DB_USER=referrals_app
REFERRALS_DB_PASSWORD=

# --- "Request a Health System Analysis" B2B lead form (isolated DB) ---
HEALTH_SYSTEMS_DB_NAME=thymos_health_systems
HEALTH_SYSTEMS_DB_USER=health_systems_app
HEALTH_SYSTEMS_DB_PASSWORD=

# --- "Send Me the Guide" lead-capture form (isolated DB) ---
# Same fallback rules as the WAITLIST_ vars.
GUIDE_DB_NAME=thymos_guide
GUIDE_DB_USER=guide_app
GUIDE_DB_PASSWORD=

# --- Shared / production ---
# Cloud SQL instance connection name: project:region:instance
# Used by the Cloud SQL Auth Proxy locally, and by the
# @google-cloud/cloud-sql-connector package in production on Cloud Run.
INSTANCE_CONNECTION_NAME=thymos-health:us-west2:thymos-db

# --- Anti-abuse ---
# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). If TURNSTILE_SECRET_KEY
# is blank, CAPTCHA verification is skipped (honeypot + rate-limit still apply);
# once set, a missing/invalid token is rejected. Test keys that always pass:
#   site 1x00000000000000000000AA  /  secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HMAC secret gating PATCH /api/quiz-submissions/:id. Blank = check disabled.
SUBMISSION_TOKEN_SECRET=

# --- Refer-a-friend landing page (/r/<CODE>) ---
# Display copy only. The real amounts live in thymos-backend's referral_programs
# row (ADR-0004) and this site never calls the backend, so keep these in step
# with that row when Thymos changes the program. Blank = "$50" / "$50".
REFERRAL_RECIPIENT_DISCOUNT=
REFERRAL_REFERRER_REWARD=
